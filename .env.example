# ---------------------------------------------------------------------------
# Watch Monitor — the variables a deployment actually has to be given.
#
# Copy the names into the host's variable editor and fill in the values.
# Everything not listed here has a working default; see README §Environment
# for the full set and what each one changes.
#
# This file carries NO values. It is committed on purpose, so the next
# deployment — a new host, a new account — starts from the list rather
# than from memory. Never put real tokens in it.
# ---------------------------------------------------------------------------

# -- Required: the price feed -----------------------------------------------
# Without a token the monitor boots but is blind: no candles, so no touch,
# no rejection, no confirmation.
CTRADER_MCP_TOKEN=
# Only set this if the upstream is not the default
# (https://mcp.ctrader.com/trading/mcp).
CTRADER_MCP_URL=

# -- Required: where confirmations go ---------------------------------------
# Without these the monitor still works and still resolves setups, but no
# alert ever reaches you — which for a live validator is the same as being
# switched off. Check with GET /test-telegram after deploying.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -- Required: the front door -----------------------------------------------
# Leave this unset and /paste, /register_watch and the MCP endpoint are open
# to anyone who finds the URL. The service warns loudly at boot when it is
# missing. Any long random string will do; it is yours to choose.
WATCH_MONITOR_AUTH_TOKEN=

# -- Required in production: durable state ----------------------------------
# Point this at a persistent volume. Without one the service runs, but a
# restart loses active watches and the undelivered outbox — and with
# auto-trade armed, that record is what stops a restart resubmitting an
# order that already went out.
#   Railway: add a volume, then set /data/watch-state.json
STATE_FILE=/data/watch-state.json

# -- Optional: the host sets this itself on most platforms ------------------
# PORT=8080

# ---------------------------------------------------------------------------
# Auto-trade is OFF unless BOTH of these are set. Leave them alone until
# you have watched the monitor confirm setups you agree with, on a demo
# account, for long enough to trust it. AUTO_TRADE_CONFIRMED must read
# exactly: I ACCEPT AUTOMATED ORDER EXECUTION
# ---------------------------------------------------------------------------
# AUTO_TRADE_ENABLED=false
# AUTO_TRADE_CONFIRMED=

# The analysis surface. With this on, the tool list shrinks to what an
# analysis session actually uses: every read, plus register_watch.
#
# The six it hides — register_trap_watch, cancel_watch, the two
# news-lockout tools and the two auto-trade tools — are operator
# controls. They belong to whoever runs the monitor, not to the analysis,
# and each costs a confirmation prompt mid-read for a tool that session
# was never going to call.
#
# register_watch survives, and with auto-trade off it does not prompt
# either: it creates a watch and sends a Telegram message, destroys
# nothing, and deduplicates, so it is declared non-destructive and
# idempotent — which it always was, and never said.
#
# Arm auto-trade and the prompt returns, because then that same call can
# become a real order. Thirteen prompts become zero, or one when one is
# genuinely warranted.
MCP_ANALYSIS_ONLY=false
